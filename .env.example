# Copy to .env (never committed) and fill in. Only the venues you enable need keys.

# Polymarket US (polymarket.us)
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# Kalshi — production or demo (demo-api.kalshi.co, fake money)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_ENV=demo

# Optional: path to a config file (default ~/.config/quanty/config.toml)
# QUANTY_CONFIG=
