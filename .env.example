# Copy to .env (never committed) and fill in. Only live venue connections need keys; recording
# public feeds, replaying and backtesting don't.

# Polymarket US (polymarket.us): key id and base64 Ed25519 private key
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# Kalshi: key id and PEM private key (Ed25519 or RSA). The PEM may be pasted on one line, or set
# KALSHI_PRIVATE_KEY_PATH to a .pem file instead.
KALSHI_KEY_ID=
KALSHI_SECRET_KEY=
# KALSHI_PRIVATE_KEY_PATH=

# Optional: path to a config file (default ~/.config/quanty/config.toml)
# QUANTY_CONFIG=
